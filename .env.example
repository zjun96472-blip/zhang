# Backend
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
USE_MOCK_LLM=false
MYSQL_URL=mysql+pymysql://shopmate:shopmate@mysql:3306/shopmate
REDIS_URL=redis://redis:6379/0
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=shopmate_kb
MEMORY_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:3000
AUTH_SECRET_KEY=replace_with_a_secure_secret_at_least_32_chars_long
AUTH_COOKIE_NAME=shopmate_access_token
ACCESS_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
